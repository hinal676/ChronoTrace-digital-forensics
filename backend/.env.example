# --- MongoDB ---
CHRONOTRACE_MONGO_URI=mongodb://localhost:27017
CHRONOTRACE_MONGO_DB=chronotrace
CHRONOTRACE_MONGO_TIMEOUT_MS=5000

# --- API ---
CHRONOTRACE_API_TITLE=ChronoTrace
CHRONOTRACE_API_HOST=127.0.0.1
CHRONOTRACE_API_PORT=8000
CHRONOTRACE_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Data / model paths ---
CHRONOTRACE_DATASET_PATH=data/chronotrace_network_5000.csv
CHRONOTRACE_MODEL_PATH=app/ml/model.pkl

# --- Graph engine ---
# Seconds before the cached NetworkX graph is rebuilt from MongoDB.
CHRONOTRACE_GRAPH_CACHE_TTL=300
# Hard cap on events pulled into a single graph build.
CHRONOTRACE_GRAPH_MAX_EVENTS=200000

# --- Live collector ---
CHRONOTRACE_COLLECTOR_API_URL=http://127.0.0.1:8000
CHRONOTRACE_COLLECTOR_INTERVAL=5.0
